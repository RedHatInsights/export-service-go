// Set up with the MintMaker Automerge plugin v1.0.0: https://github.com/gwenneg/mintmaker-automerge
// Overrides MintMaker's global config: https://github.com/konflux-ci/mintmaker/blob/main/config/renovate/renovate.json
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // GitHub merges each PR as soon as its required checks pass, once the Konflux app is
  // exempt from the approval rule.
  "platformAutomerge": true,
  "extends": [
    // Keep even when every action is pinned: it pins the next one added.
    "helpers:pinGitHubActionDigests"
  ],
  "tekton": {
    // The PR's own Konflux build runs the updated pipeline.
    "automerge": true,
    // Any day, instead of MintMaker's Saturday batch.
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      // Needed even when SHA-pinned: without it, a v4-style tag gets only digest PRs, which
      // never automerge. Expect one manual PR that writes the full version.
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "rangeStrategy": "pin"
    },
    {
      // Named actions only: an action runs code in CI. Digest-only updates stay manual:
      // a moved tag with no version change is what a hijacked action looks like.
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor"],
      "matchDepNames": ["actions/checkout", "actions/setup-go", "fullsend-ai/fullsend"],
      "automerge": true,
      "groupName": "GitHub Actions"
    },
    {
      // Repository rule, not written by the plugin:
      // Pinned to @main, so every update is digest-only; named here to bypass
      // the digest-stays-manual rule above.
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest"],
      "matchDepNames": ["konflux-ci/renovate-config-validator-action"],
      "automerge": true
    },
    {
      // Repository rule, not written by the plugin:
      // Tracked by two managers: the pre-commit hook rev and golangci-lint-action's version: input.
      "matchManagers": ["pre-commit", "github-actions"],
      "matchDepNames": ["golangci/golangci-lint"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "groupName": "golangci-lint"
    },

    {
      // The Konflux PR build builds and tests the image. A digest update rebuilds the same
      // tag; a new RHEL or JDK line is a major and stays manual.
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["digest", "patch", "minor"],
      "automerge": true,
      "groupName": "base images"
    },
    {
      // Keep even when every FROM line is pinned: it pins the next image added.
      "matchManagers": ["dockerfile"],
      "pinDigests": true
    },

    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "groupName": "Go modules"
    },
    {
      // Repository rule, not written by the plugin:
      // go-genproto is machine-generated from Google's API definitions with no release
      // process, so it never gets tagged: every update is a digest bump (never patch/minor
      // above). Grouped because both packages come from the same repo and always move
      // together on the same upstream commit.
      "matchManagers": ["gomod"],
      "matchDepNames": [
        "google.golang.org/genproto/googleapis/api",
        "google.golang.org/genproto/googleapis/rpc"
      ],
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "groupName": "google.golang.org/genproto"
    },
    {
      // Repository rule, not written by the plugin:
      // google/pprof has no tags or releases either, so it's digest-only like genproto
      // above. It's also only pulled in indirectly (go.mod marks it "// indirect"; `go mod
      // why` confirms this module doesn't need it directly) — nothing we import runs its code.
      "matchManagers": ["gomod"],
      "matchDepNames": ["github.com/google/pprof"],
      "matchUpdateTypes": ["digest"],
      "automerge": true
    },
    {
      // The toolchain is every developer's compiler, not just CI's.
      // No group: a member that never automerges would hold the whole group.
      "matchManagers": ["gomod"],
      "matchDepTypes": ["toolchain"],
      "automerge": false,
      "groupName": null
    }
  ]
}
